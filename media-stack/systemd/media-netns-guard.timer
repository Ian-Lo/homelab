[Unit]
Description=Run media-netns-guard.service on a timer

[Timer]
# ~2 minutes: fast enough to catch a drifted/zombied dependant (see
# DESIGN.md, "The netns lifecycle trap") reasonably promptly, without
# polling the Docker socket harder than the vpn image's own healthcheck does
# (60s interval) -- same order of magnitude, not an aggressive multiple of
# it. Tighten if it proves too slow in practice; loosen if it proves too
# chatty. Note the debounce in netns-guard.sh matters more than this
# interval: a guard that alerts every two minutes through a real outage has
# only relocated the silence.
OnBootSec=2min
OnUnitActiveSec=2min
AccuracySec=10s

[Install]
WantedBy=timers.target
