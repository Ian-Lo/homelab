# Copy to .env and fill in.  .env is gitignored — it holds real values.
#
# Two consumers, one file:
#   * `docker compose` reads .env from this directory automatically.
#   * install-on-host.sh installs a copy at /etc/media-stack/env (root:root,
#     mode 600) for the host-side scripts and systemd units to source.
#
# Every variable below is REQUIRED unless marked optional. The compose files
# and scripts use ${VAR:?} rather than a default on purpose: a script that
# falls back to a guessed LAN address or media root is worse than one that
# refuses to start, because the guess fails silently and in the wrong place.

# Single parent directory of BOTH downloads/ and library/, on ONE filesystem.
# Hardlinked imports (the *arrs' whole seeding-without-duplication model)
# cannot cross a filesystem boundary, so two separate mounts here quietly
# turn every import into a full copy.
MEDIA_ROOT=/srv/media

# The host's LAN address. Published container ports bind to this rather than
# 0.0.0.0, so the WebUIs are not exposed on every interface the host has.
LAN_IP=192.168.1.50

# Your LAN in CIDR. CHECK THE ACTUAL NETMASK rather than assuming /24 — if
# the real network is wider, clients outside the range you write here lose
# access to the WebUIs, and the symptom looks like an application fault.
# Used both for the VPN container's LOCAL_NETWORK (the hole in the kill
# switch that lets WebUI replies out) and for the DOCKER-USER DROP rules.
LAN_SUBNET=192.168.1.0/24

# Host user/group that owns the media tree. The *arr containers run as
# PUID/PGID 1000 with UMASK 002, so this account should be uid/gid 1000 for
# imports to land manageable by both sides.
MEDIA_USER=media
MEDIA_GROUP=media

# The host's `render` group id, for Jellyfin's hardware transcoding.
# Differs per distribution and per host:
#   getent group render | cut -d: -f3
RENDER_GID=993

# VPN provider region id. REQUIRED, no default: it must be a
# port-forwarding-capable region, and which ones qualify changes over time.
# A wrong value does NOT error — the tunnel connects and port forwarding
# simply never arrives, so check the log rather than assuming.
PIA_LOC=

# Random secret closing Byparr's otherwise-unauthenticated /load endpoint,
# which is an SSRF primitive that drives a headless browser to arbitrary
# URLs and returns the page text.  openssl rand -hex 32
BYPARR_OWUI_KEY=

# Optional. IANA timezone; defaults to Etc/UTC everywhere if unset.
TZ=Etc/UTC
